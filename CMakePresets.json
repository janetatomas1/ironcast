{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug",
      "description": "GCC Debug, with the Conan dependencies from scripts/install",
      "inherits": "base",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/submodules/conanfiles/third-party/gcc/debug/conan_toolchain.cmake"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "description": "GCC Release, with the Conan dependencies from scripts/install",
      "inherits": "base",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/submodules/conanfiles/third-party/gcc/release/conan_toolchain.cmake"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Clang Debug",
      "description": "Clang Debug, with the Conan dependencies from scripts/install",
      "inherits": "base",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/submodules/conanfiles/third-party/clang/debug/conan_toolchain.cmake"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release",
      "description": "Clang Release, with the Conan dependencies from scripts/install",
      "inherits": "base",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/submodules/conanfiles/third-party/clang/release/conan_toolchain.cmake"
      }
    },
    {
      "name": "emscripten-debug",
      "displayName": "Emscripten Debug",
      "description": "Emscripten (WebAssembly) Debug, with the Conan dependencies from scripts/install",
      "inherits": "base",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "$env{EMSDK}/upstream/emscripten/emcc",
        "CMAKE_CXX_COMPILER": "$env{EMSDK}/upstream/emscripten/em++",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/submodules/conanfiles/third-party/emscripten/debug/conan_toolchain.cmake"
      }
    },
    {
      "name": "emscripten-release",
      "displayName": "Emscripten Release",
      "description": "Emscripten (embly) Release, with the Conan dependencies from scripts/install",
      "inherits": "base",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "$env{EMSDK}/upstream/emscripten/emcc",
        "CMAKE_CXX_COMPILER": "$env{EMSDK}/upstream/emscripten/em++",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/submodules/conanfiles/third-party/emscripten/release/conan_toolchain.cmake"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug",
      "description": "MSVC Debug, with the Conan dependencies from scripts/install; run from a Visual Studio developer prompt (Ninja needs its environment)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/submodules/conanfiles/third-party/msvc/debug/conan_toolchain.cmake"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release",
      "description": "MSVC Release, with the Conan dependencies from scripts/install; run from a Visual Studio developer prompt (Ninja needs its environment)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/submodules/conanfiles/third-party/msvc/release/conan_toolchain.cmake"
      }
    },
    {
      "name": "clang-cl-debug",
      "displayName": "clang-cl Debug",
      "description": "clang-cl Debug, with the Conan dependencies from scripts/install",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/submodules/conanfiles/third-party/clang-cl/debug/conan_toolchain.cmake"
      }
    },
    {
      "name": "clang-cl-release",
      "displayName": "clang-cl Release",
      "description": "clang-cl Release, with the Conan dependencies from scripts/install",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/submodules/conanfiles/third-party/clang-cl/release/conan_toolchain.cmake"
      }
    }
  ],
  "testPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-cl-debug",
      "configurePreset": "clang-cl-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-cl-release",
      "configurePreset": "clang-cl-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
